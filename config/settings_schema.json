[
  {
    "name": "theme_info",
    "theme_name": "PupCloud",
    "theme_version": "1.0.0",
    "theme_author": "PupCloud",
    "theme_documentation_url": "https://pupcloud.com",
    "theme_support_url": "https://pupcloud.com/support"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 160
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32x32 PNG recommended"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#fbf7f2"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Text",
        "default": "#2b2620"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#c98b6b"
      },
      {
        "type": "color",
        "id": "color_accent_foreground",
        "label": "Accent text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#e9ddd0"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#7a6f63"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1280
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "page"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL", "default": "https://instagram.com/pupcloud" },
      { "type": "text", "id": "social_twitter", "label": "Twitter/X URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL", "default": "https://tiktok.com/@pupcloud" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" }
    ]
  }
]
