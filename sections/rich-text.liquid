<section class="section">
  <div class="page-width" style="max-width:760px;text-align:{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
      {%- when 'heading' -%}
        <h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
      {%- when 'text' -%}
        <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}
        <a href="{{ block.settings.link }}" class="btn btn--primary" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select", "id": "alignment", "label": "Alignment",
      "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],
      "default": "center"
    }
  ],
  "blocks": [
    {"type":"heading","name":"Heading","settings":[{"type":"text","id":"heading","label":"Heading","default":"Built for happy naps"}]},
    {"type":"text","name":"Text","settings":[{"type":"richtext","id":"text","label":"Text","default":"<p>PupCloud started with one stubborn rescue who refused to sleep on anything that wasn’t exactly right. Today we make beds for thousands of picky pups around the world.</p>"}]},
    {"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Label","default":"Read our story"},{"type":"url","id":"link","label":"Link"}]}
  ],
  "presets": [{"name":"Rich text","blocks":[{"type":"heading"},{"type":"text"}]}]
}
{% endschema %}
