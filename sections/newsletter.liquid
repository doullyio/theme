<section class="section" style="text-align:center">
  <div class="page-width" style="max-width:640px">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p style="color:var(--color-muted)">{{ section.settings.subtext }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
      <div style="display:flex;gap:.5rem;max-width:480px;margin:1rem auto 0">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required style="flex:1;padding:.875rem 1rem;border:1px solid var(--color-border);border-radius:.25rem;background:var(--color-background);color:var(--color-foreground)">
        <button type="submit" class="btn btn--primary">{{ 'general.newsletter.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe to our emails" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Be the first to know about new collections and exclusive offers." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
